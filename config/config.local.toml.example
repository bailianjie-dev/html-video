# Local override template (secrets / machine-specific).
# Copy to config.local.toml and fill in real values:
#
#   cp config/config.local.toml.example config/config.local.toml
#
# Only include sections/keys you need to override.
# Non-empty local keys win over config/config.toml.
# If you define any [[auth.users]] here, they fully replace base users.
#
# Do not commit config.local.toml (gitignored via config/*.local.toml).

[database]
# PostgreSQL is required; there is no filesystem fallback switch.
host = "127.0.0.1"
port = 5432
name = "html_video"
user = "postgres"
password = "CHANGE_ME"

[oss]
# Master switch for object storage (Aliyun OSS).
# false: do not connect; assets / HTML / exports stay local.
# true: enable upload/download (fill real keys below; usually needs [database] too).
# Base config defaults to false — set true here only when this machine should use OSS.
enabled = true
provider = "aliyun"
endpoint = "oss-cn-hangzhou.aliyuncs.com"
bucket = "your-bucket"
access_key_id = "CHANGE_ME"
access_key_secret = "CHANGE_ME"
# Optional. Defaults to https://<bucket>.<endpoint> when empty.
public_base_url = ""
prefix = "albumgen/"

[auth]
# Shared default password for users below that omit `password`.
password = "CHANGE_ME"

[[auth.users]]
user_id = "admin"
display_name = "管理员"

[[auth.users]]
user_id = "alice"
display_name = "Alice"

[[auth.users]]
user_id = "bob"
display_name = "Bob"
# Optional per-user password:
# password = "bob-only-password"

[agent]
# Mapped to HV_PI_* for the Pi Agent SDK.
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
api_key = "CHANGE_ME"
model = "qwen3.7-plus"
# Max completion tokens per reply. Default 16384 if unset/invalid.
max_tokens = 16384
